# ═══════════════════════════════════════════════════════════════
#  ROOT .env — Docker Compose variable substitution
#  Copy to .env and fill in real values. NEVER commit .env.
#
#  Generate secrets:
#    openssl rand -hex 32       → 64-char hex string
#    openssl rand -base64 32    → 44-char base64 string
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────
# Used by the postgres container to initialize the database.
# Also referenced in backend/.env DATABASE_URL (must match).
# Avoid @ # % in the password to simplify URL encoding.
POSTGRES_PASSWORD=

# Optional overrides (defaults shown):
# POSTGRES_USER=spare_partner_user
# POSTGRES_DB=spareparts

# ── Timezone ──────────────────────────────────────────────────
APP_TIMEZONE=Europe/Stockholm

# ── Notes on production deployment ───────────────────────────
# HTTPS is handled by Caddy (caddy:2-alpine) via docker-compose.prod.yml.
# Caddy obtains TLS certificates from Let's Encrypt automatically.
# No NEXT_PUBLIC_BACKEND_URL is required — all browser API traffic is
# routed through Next.js rewrites server-side; the browser never contacts
# the backend directly.
#
# Before first production deploy:
#   1. Set DNS A record: spare-parts.tawdev.com → server public IP
#   2. Open ports 80 and 443 in your firewall / AWS security group
#   3. Fill in backend/.env with JWT_SECRET, DATABASE_URL, GEMINI_API_KEY, etc.
