# ── Backend (backend/.env) ───────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# AI API Key
# Single provider — get key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Mock mode (set true to develop without real API keys)
MOCK_MODE=false
OPENAI_MOCK_MODE=false
GEMINI_MOCK_MODE=false
CLAUDE_MOCK_MODE=false

# Processing
MAX_ROWS_WARNING=5000
MAX_ROWS_LIMIT=10000
BATCH_SIZE=5
MAX_CONCURRENCY=5
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_DELAY_MS=1000
CACHE_TTL_SECONDS=86400

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
# Set true to also write logs to backend/logs/ai/{YYYY-MM-DD}.log
LOG_WRITE=false

# ── Frontend (frontend/.env.local) ──────────────────
# NEXT_PUBLIC_APP_NAME=Spare Parts Web Verifier
# BACKEND_URL=http://localhost:3001
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
