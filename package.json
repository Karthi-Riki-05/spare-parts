{
  "name": "spare-parts-verifier-root",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "npm start --prefix backend",
    "test": "npm test --prefix backend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "test:e2e": "npx playwright test --reporter=html",
    "test:e2e:backend": "npx playwright test --project='Backend EJS - Desktop' --reporter=html",
    "test:e2e:frontend": "npx playwright test --project='Frontend Next.js - Desktop' --reporter=html",
    "test:e2e:mobile": "npx playwright test --project='Frontend Next.js - Mobile' --reporter=html",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "test:all": "npm run test:backend && npm run test:frontend && npx playwright test",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "concurrently": "^8.2.2"
  }
}
