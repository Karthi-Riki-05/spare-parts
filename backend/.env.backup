# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000


# Google Gemini (single provider — all AI calls)
GEMINI_API_KEY=AIzaSyCWRn8mpMeTNqy_LI24Zxtopz3VfHaG6wU


# Processing limits
MAX_ROWS_WARNING=5000
MAX_ROWS_LIMIT=10000
BATCH_SIZE=5
MAX_CONCURRENCY=2
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_DELAY_MS=1000
CACHE_TTL_SECONDS=86400

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Logging
LOG_LEVEL=info

# Mock mode — set true to use sample data without real API keys (development only)
MOCK_MODE=false
OPENAI_MOCK_MODE=false
GEMINI_MOCK_MODE=false
CLAUDE_MOCK_MODE=false

# File logging — true writes logs to backend/logs/ai/{YYYY-MM-DD}.log
LOG_WRITE=true
