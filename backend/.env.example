# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Gemini (single provider — all AI calls) ──────────────
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_2=optional_second_key_for_parallel
# GEMINI_API_KEY_3=optional_third_key_for_parallel

# ─── Processing limits ────────────────────────────────────
MAX_ROWS_WARNING=5000
MAX_ROWS_LIMIT=10000
BATCH_SIZE=5
MAX_CONCURRENCY=15
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_DELAY_MS=1000
CACHE_TTL_SECONDS=86400

# ─── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_WRITE=true

# ─── Mock mode (dev only — skips real AI calls) ───────────
MOCK_MODE=false
OPENAI_MOCK_MODE=false
GEMINI_MOCK_MODE=false
CLAUDE_MOCK_MODE=false

# ─── Auth (legacy single-admin — replaced in P3) ──────────
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
COOKIE_SECURE=false

# ─── PostgreSQL ───────────────────────────────────────────
# Local host run:   postgresql://postgres:postgres@localhost:5432/spareparts
# Docker compose:   postgresql://postgres:postgres@postgres:5432/spareparts
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/spareparts

# ─── Super admin seed (created on boot by migration runner) ──
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me

# ─── Token expirations ────────────────────────────────────
CONFIRMATION_TOKEN_HOURS=72
PASSWORD_RESET_MINUTES=60

# ─── Email (SMTP via Hostinger / any SMTP provider) ───────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_mailbox_password
NOTIFY_FROM_EMAIL=noreply@yourdomain.com

# ─── App URL (used for email links — must be reachable) ───
# Dev:  http://localhost:3000
# Prod: https://spare-parts.tawdev.com
APP_URL=http://localhost:3000

# ─── Timezone ─────────────────────────────────────────────
APP_TIMEZONE=Europe/Stockholm
