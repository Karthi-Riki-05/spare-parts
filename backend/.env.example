# ═══════════════════════════════════════════════════════════════
#  BACKEND .env — copy to .env and fill in real values
#  NEVER commit this file with real secrets.
#
#  Generate secrets:
#    openssl rand -hex 32       → use for JWT_SECRET
#    openssl rand -base64 24    → use for passwords
# ═══════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Gemini (single provider — all AI calls) ──────────────────
# Get key from https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_API_KEY_2=   # optional second key for higher concurrency
# GEMINI_API_KEY_3=   # optional third key

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED. Generate with:  openssl rand -hex 32
# Must be ≥32 chars and must not be a well-known placeholder.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Set to true once the app is behind HTTPS (required in production).
COOKIE_SECURE=false

# ── PostgreSQL ────────────────────────────────────────────────
# Docker Compose (dev):  postgresql://spare_partner_user:PASSWORD@postgres:5432/spareparts
# Local dev (no Docker): postgresql://postgres:postgres@localhost:5432/spareparts
# Special chars in the password must be URL-encoded: @ → %40, # → %23
DATABASE_URL=

# ── Super admin seed ─────────────────────────────────────────
# Created on first boot. Leave blank to skip auto-seeding.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Legacy default company seed (P2 bridge — leave blank in new installs) ─
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Processing limits ─────────────────────────────────────────
MAX_ROWS_WARNING=5000
MAX_ROWS_LIMIT=10000
BATCH_SIZE=5
MAX_CONCURRENCY=15
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_DELAY_MS=1000
CACHE_TTL_SECONDS=86400

# ── Rate limiting ─────────────────────────────────────────────
# Global: applied to all /api/* routes (except health/auth/super-admin)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
# Auth-specific: applied at the route level before the global limiter
# Login: 20 failed attempts per 15 minutes per IP (successful logins don't count)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
# Forgot-password + reset-password: 10 requests per hour per IP
FORGOT_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_RATE_LIMIT_MAX=10

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
LOG_WRITE=false

# ── Mock mode (dev only — skips real API calls) ───────────────
MOCK_MODE=false
OPENAI_MOCK_MODE=false
GEMINI_MOCK_MODE=false
CLAUDE_MOCK_MODE=false

# ── Email (SMTP — Hostinger or any SMTP provider) ─────────────
# REQUIRED IN PRODUCTION: all three SMTP_* values must be set.
#   • Company creation will fail (503) if SMTP is not configured — the system
#     enforces atomicity: no company row is created unless the confirmation
#     email can be delivered.
#   • Password-reset emails will fail silently if SMTP is missing.
# Leave SMTP_HOST blank only in local dev where email is not needed.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM_EMAIL=noreply@yourdomain.com

# ── App URL (used in email links — must be publicly reachable) ─
# Dev:  http://localhost:3000
# Prod: https://spare-parts.yourdomain.com
APP_URL=http://localhost:3000

# ── Timezone ──────────────────────────────────────────────────
APP_TIMEZONE=Europe/Stockholm

# ── Background jobs ───────────────────────────────────────────
BACKGROUND_THRESHOLD=20
